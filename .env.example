# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# NextAuth
AUTH_SECRET="your-secret-here"  # Generate with: openssl rand -base64 32
NEXTAUTH_URL="https://your-app.vercel.app"

# Scheduled daily-update sender (Vercel Cron sends this as a Bearer token)
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Optional real messaging providers. When unset, messages are simulated and logged
# to the OutboundMessageLog audit trail (no external delivery).
# RESEND_API_KEY=""            # Email delivery via Resend
# TWILIO_ACCOUNT_SID=""        # WhatsApp delivery via Twilio
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM=""      # e.g. "whatsapp:+14155238886"
